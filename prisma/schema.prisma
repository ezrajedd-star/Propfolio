// Propfolio database schema.
//
// Conventions
// - Primary keys are UUIDv7 (time-ordered) unless stated otherwise.
// - Instants are `timestamptz` (stored in UTC). Business dates (lease start/end, due dates)
//   will be `date` columns interpreted in Asia/Manila.
// - Money will be `Decimal(14, 2)` — never floats.
// - Business records carry createdAt/updatedAt/createdById/updatedById and are archived
//   (`archivedAt`) rather than deleted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  /// An Admin who also controls billing and can't be removed. One per account.
  OWNER
  ADMIN
  LEASING_STAFF
  VIEWER
}

// ─── Accounts ──────────────────────────────────────────────────────────────────

enum AccountStatus {
  ACTIVE
  /// Turned off by the platform admin: nobody in it can sign in. Nothing is deleted.
  SUSPENDED
}

enum Plan {
  FREE
  PRO
  PREMIUM
}

/// One customer: a company or person who leases out property. Every business record belongs to
/// exactly one account. Not filtered by row-level security (only the platform admin lists them),
/// but customers only ever read their own through their session.
model Account {
  id              String        @id @default(uuid(7)) @db.Uuid
  /// The name they lease under, e.g. "Santos Realty Corp." Shown in emails and the privacy notice.
  name            String
  status          AccountStatus @default(ACTIVE)
  plan            Plan          @default(PREMIUM)
  /// While set and in the future, the account is on a free Premium trial.
  trialEndsAt     DateTime?     @db.Timestamptz(3)
  /// Paid until this Manila date (inclusive), e.g. after a manual bank transfer.
  paidUntil       DateTime?     @db.Date
  suspendedAt     DateTime?     @db.Timestamptz(3)
  suspendedReason String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  memberships        Membership[]
  sessions           Session[]
  manualPayments     ManualPayment[]
  trialReminders     TrialReminder[]
  auditLogs          AuditLog[]
  settings           Setting[]
  buildings          Building[]
  unitTypes          UnitType[]
  units              Unit[]
  tenants            Tenant[]
  leases             Lease[]
  leaseCounters      LeaseCounter[]
  leaseDrafts        LeaseDraft[]
  userPreferences    UserPreference[]
  reminderEvents     ReminderEvent[]
  reminderDigests    ReminderDigest[]
  charges            Charge[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  paymentCounters    PaymentCounter[]
  documents          Document[]
  feedback           Feedback[]
}

/// A person's place in an account, with their role there. One person can belong to several
/// accounts (e.g. an outside accountant). Turning someone off in an account doesn't touch others.
model Membership {
  id         String    @id @default(uuid(7)) @db.Uuid
  accountId  String    @default(dbgenerated("current_account_id()")) @db.Uuid
  account    Account   @relation(fields: [accountId], references: [id])
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role
  isActive   Boolean   @default(true)
  lastUsedAt DateTime? @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  @@unique([accountId, userId])
  @@index([userId])
}

/// A "your trial ends soon" email (7 days and 1 day before). One row per trial end and lead
/// time makes the daily job idempotent; extending a trial gives a new end, so it is reminded again.
/// Propfolio's own record: never reachable from customer work.
model TrialReminder {
  id          String   @id @default(uuid(7)) @db.Uuid
  accountId   String   @db.Uuid
  account     Account  @relation(fields: [accountId], references: [id])
  trialEndsAt DateTime @db.Timestamptz(3)
  daysBefore  Int
  /// How many people it went to (the Owner and Admins). No addresses are stored.
  recipients  Int
  sentAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([accountId, trialEndsAt, daysBefore])
}

/// A payment recorded by hand by the platform admin (bank transfer for annual or corporate
/// customers). Not an official receipt; posted records are never edited.
model ManualPayment {
  id           String   @id @default(uuid(7)) @db.Uuid
  accountId    String   @db.Uuid
  account      Account  @relation(fields: [accountId], references: [id])
  amount       Decimal  @db.Decimal(14, 2)
  /// The account is paid up to and including this Manila date.
  paidUntil    DateTime @db.Date
  reference    String
  note         String?
  recordedById String   @db.Uuid
  recordedAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([accountId, recordedAt])
}

// ─── Platform admin (Propfolio staff) ──────────────────────────────────────────

/// Propfolio's own staff. Separate from customer users: no membership in any account, so no
/// access to tenant records. Two-step sign-in (authenticator app) is always required.
model PlatformAdmin {
  id                  String    @id @default(uuid(7)) @db.Uuid
  name                String
  /// Always stored lower-cased and trimmed.
  email               String    @unique
  /// Null until the admin finishes set-up with their one-time link.
  passwordHash        String?
  /// Authenticator secret, encrypted with APP_SECRET (AES-256-GCM).
  totpSecretEnc       String?
  totpConfirmedAt     DateTime? @db.Timestamptz(3)
  /// The last 30-second step used, so a code can't be used twice.
  totpLastStep        BigInt?
  setupTokenHash      String?   @unique
  setupTokenExpiresAt DateTime? @db.Timestamptz(3)
  isActive            Boolean   @default(true)
  failedLoginCount    Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(3)
  lastLoginAt         DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  sessions PlatformSession[]
}

model PlatformSession {
  id         String        @id @default(uuid(7)) @db.Uuid
  tokenHash  String        @unique
  adminId    String        @db.Uuid
  admin      PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime      @db.Timestamptz(3)
  revokedAt  DateTime?     @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?

  @@index([adminId])
}

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  name               String
  /// Always stored lower-cased and trimmed.
  email              String    @unique
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime? @db.Timestamptz(3)
  lastLoginAt        DateTime? @db.Timestamptz(3)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(3)
  /// Two-step sign-in: authenticator secret, encrypted with APP_SECRET (AES-256-GCM).
  totpSecretEnc      String?
  /// Set when two-step sign-in is on (the first code was confirmed).
  totpConfirmedAt    DateTime? @db.Timestamptz(3)
  /// The last 30-second step used, so a code can't be used twice.
  totpLastStep       BigInt?
  /// Owners and Admins may wait until this moment before two-step sign-in is enforced.
  twoStepGraceUntil  DateTime? @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  memberships         Membership[]
  recoveryCodes       RecoveryCode[]
  trustedDevices      TrustedDevice[]
  signInChallenges    SignInChallenge[]
}

/// One-time codes for two-step sign-in when the phone is lost. Only hashes are stored.
model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

/// A browser where the person ticked "Don't ask for a code on this device for 30 days".
/// The browser holds a random token; only its hash is stored.
model TrustedDevice {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  userAgent  String?

  @@index([userId])
}

/// The password was right; waiting for the 6-digit code (5 minutes, 5 tries).
model SignInChallenge {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String    @db.Uuid
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  ipAddress String?
  userAgent String?

  @@index([userId])
}

/// Server-side session. The browser only holds an opaque random token; we store its SHA-256.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The account this session works in (a person can belong to several).
  accountId  String    @db.Uuid
  account    Account   @relation(fields: [accountId], references: [id])
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  /// Absolute expiry, regardless of activity.
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  tokenHash   String    @unique
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  createdById String?   @db.Uuid

  @@index([userId])
}

/// Append-only. UPDATE and DELETE are rejected by a database trigger (see migration).
model AuditLog {
  /// Monotonic sequence so entries have a strict order.
  seq        BigInt   @id @default(autoincrement())
  /// Null for platform-admin actions and failed sign-ins that match no account.
  accountId  String?  @default(dbgenerated("current_account_id()")) @db.Uuid
  account    Account? @relation(fields: [accountId], references: [id])
  at         DateTime @default(now()) @db.Timestamptz(3)
  /// Null for system actions (worker jobs) and failed logins for unknown accounts.
  actorId    String?  @db.Uuid
  /// Snapshot of the actor's name and role at the time of the action.
  actorName  String?
  actorRole  Role?
  action     String
  entityType String
  entityId   String?
  /// { field: { before, after } } for updates; full snapshot for creates.
  changes    Json?
  /// Extra context (e.g. reason for a void, export filters, failure reason).
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  @@index([accountId, at])
  @@index([at])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
}

model Setting {
  accountId   String   @default(dbgenerated("current_account_id()")) @db.Uuid
  account     Account  @relation(fields: [accountId], references: [id])
  key         String
  value       Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  @@id([accountId, key])
}

// ─── Property structure ────────────────────────────────────────────────────────

enum BuildingType {
  COMMERCIAL
  RESIDENTIAL
  INDUSTRIAL_COMPLEX
  MIXED
}

model Building {
  id         String       @id @default(uuid(7)) @db.Uuid
  /// The customer account this row belongs to. Filled in by the database from the request's
  /// account (see src/server/db.ts); row-level security keeps accounts apart.
  accountId  String       @default(dbgenerated("current_account_id()")) @db.Uuid
  account    Account      @relation(fields: [accountId], references: [id])
  name       String
  /// Short code used in lists and unit labels, e.g. "TWR1". Unique within the account.
  code       String
  address    String
  type       BuildingType
  notes      String?
  archivedAt DateTime?    @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  units Unit[]

  @@unique([accountId, code])
}

model UnitType {
  id             String    @id @default(uuid(7)) @db.Uuid
  /// The customer account this row belongs to. Filled in by the database from the request's
  /// account (see src/server/db.ts); row-level security keeps accounts apart.
  accountId      String    @default(dbgenerated("current_account_id()")) @db.Uuid
  account        Account   @relation(fields: [accountId], references: [id])
  name           String
  /// Default reminder settings for units of this type (ReminderConfig JSON). Null = system default.
  reminderConfig Json?
  sortOrder      Int       @default(0)
  archivedAt     DateTime? @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  units Unit[]

  @@unique([accountId, name])
}

enum UnitStatusOverride {
  UNDER_RENOVATION
  UNAVAILABLE
}

model Unit {
  id             String              @id @default(uuid(7)) @db.Uuid
  /// The customer account this row belongs to. Filled in by the database from the request's
  /// account (see src/server/db.ts); row-level security keeps accounts apart.
  accountId      String              @default(dbgenerated("current_account_id()")) @db.Uuid
  account        Account             @relation(fields: [accountId], references: [id])
  buildingId     String              @db.Uuid
  building       Building            @relation(fields: [buildingId], references: [id])
  /// Unit number or name, unique within the building (among non-archived units).
  unitNumber     String
  unitTypeId     String              @db.Uuid
  unitType       UnitType            @relation(fields: [unitTypeId], references: [id])
  floor          String?
  /// Square metres.
  floorArea      Decimal?            @db.Decimal(10, 2)
  /// A standalone structure such as a warehouse.
  isStandalone   Boolean             @default(false)
  statusOverride UnitStatusOverride?
  /// Reminder override (ReminderConfig JSON). Null = inherit from the unit type.
  reminderConfig Json?
  notes          String?
  archivedAt     DateTime?           @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  leases Lease[]

  @@index([accountId])
  @@index([buildingId])
  @@index([unitTypeId])
}

// ─── Parties ───────────────────────────────────────────────────────────────────

enum TenantType {
  COMPANY
  INDIVIDUAL
}

enum PrivacyAckMethod {
  SIGNED_FORM
  EMAIL
  IN_PERSON
}

/// Only the fields listed in the brief (DPA proportionality). No ID numbers besides an optional TIN.
model Tenant {
  id               String            @id @default(uuid(7)) @db.Uuid
  /// The customer account this row belongs to. Filled in by the database from the request's
  /// account (see src/server/db.ts); row-level security keeps accounts apart.
  accountId        String            @default(dbgenerated("current_account_id()")) @db.Uuid
  account          Account           @relation(fields: [accountId], references: [id])
  type             TenantType
  /// The name everyone sees, including Property Management.
  displayName      String
  registeredName   String?
  tin              String?
  contactPerson    String?
  phone            String?
  email            String?
  billingAddress   String?
  notes            String?
  /// Date the privacy notice was acknowledged, and how.
  privacyAckDate   DateTime?         @db.Date
  privacyAckMethod PrivacyAckMethod?
  /// Normalised text for forgiving search (no PII beyond what is searched anyway).
  searchText       String            @default("")
  anonymizedAt     DateTime?         @db.Timestamptz(3)
  archivedAt       DateTime?         @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  leases Lease[]

  @@index([accountId])
}

// ─── Leases ────────────────────────────────────────────────────────────────────

enum LeaseStatus {
  UPCOMING
  ACTIVE
  EXPIRING
  EXPIRED
  RENEWED
  TERMINATED
}

enum AdvanceRentType {
  NONE
  MONTHS
  AMOUNT
}

enum EscalationType {
  NONE
  /// Increase rent by `escalationPercent` every `escalationEveryMonths` months.
  PERCENT
  /// Rent changes to set amounts on set dates (`escalationSteps`).
  SCHEDULE
}

model Lease {
  id                    String          @id @default(uuid(7)) @db.Uuid
  /// The customer account this row belongs to. Filled in by the database from the request's
  /// account (see src/server/db.ts); row-level security keeps accounts apart.
  accountId             String          @default(dbgenerated("current_account_id()")) @db.Uuid
  account               Account         @relation(fields: [accountId], references: [id])
  /// e.g. LSE-2026-0001
  refNo                 String
  unitId                String          @db.Uuid
  unit                  Unit            @relation(fields: [unitId], references: [id])
  tenantId              String          @db.Uuid
  tenant                Tenant          @relation(fields: [tenantId], references: [id])
  /// First and last day of the lease (inclusive), Asia/Manila calendar dates.
  startDate             DateTime        @db.Date
  endDate               DateTime        @db.Date
  /// Stored for filtering; always recomputed on read and by the daily job.
  status                LeaseStatus
  monthlyRent           Decimal         @db.Decimal(14, 2)
  /// Day of the month rent is due (1–28).
  rentDueDay            Int
  securityDeposit       Decimal         @db.Decimal(14, 2)
  advanceRentType       AdvanceRentType @default(NONE)
  advanceRentMonths     Int?
  advanceRentAmount     Decimal?        @db.Decimal(14, 2)
  escalationType        EscalationType  @default(NONE)
  escalationPercent     Decimal?        @db.Decimal(6, 3)
  escalationEveryMonths Int?
  /// [{ "date": "2028-01-01", "monthlyRent": "55000.00" }, …]
  escalationSteps       Json?
  remarks               String?
  /// The lease this one renews (renewal chain).
  previousLeaseId       String?         @unique @db.Uuid
  previousLease         Lease?          @relation("Renewal", fields: [previousLeaseId], references: [id])
  nextLease             Lease?          @relation("Renewal")
  terminationDate       DateTime?       @db.Date
  terminationReason     String?
  /// "Mark as handled": stops further expiry reminders for this lease.
  reminderHandledAt     DateTime?       @db.Timestamptz(3)
  reminderHandledById   String?         @db.Uuid
  reminderHandledNote   String?
  reminderEvents        ReminderEvent[]
  charges               Charge[]
  payments              Payment[]
  terminatedAt          DateTime?       @db.Timestamptz(3)
  terminatedById        String?         @db.Uuid
  archivedAt            DateTime?       @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid

  @@unique([accountId, refNo])
  @@index([unitId])
  @@index([tenantId])
  @@index([accountId, status])
  @@index([endDate])
}

/// Per-account, per-year counter for lease reference numbers.
model LeaseCounter {
  accountId String  @default(dbgenerated("current_account_id()")) @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])
  year      Int
  lastSeq   Int

  @@id([accountId, year])
}

/// The new-lease wizard's work in progress, kept on the server (not in the browser) so drafts
/// survive navigation without leaving tenant details on shared computers.
model LeaseDraft {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// The customer account this row belongs to. Filled in by the database from the request's
  /// account (see src/server/db.ts); row-level security keeps accounts apart.
  accountId String   @default(dbgenerated("current_account_id()")) @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id])
  userId    String   @db.Uuid
  data      Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([accountId, userId])
}

/// Per-user screen preferences, e.g. the leases grid's columns. Only the user's own rows are read.
model UserPreference {
  accountId String   @default(dbgenerated("current_account_id()")) @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id])
  userId    String   @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@id([accountId, userId, key])
}

// ─── Reminders ─────────────────────────────────────────────────────────────────

enum ReminderKind {
  /// One of the lead-time reminders (e.g. 90 days before the end).
  EXPIRY
  /// A weekly/daily repeat after the last lead-time reminder.
  REPEAT
}

enum ReminderEventStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// One reminder date for one lease. Future PENDING rows are recalculated whenever the lease or
/// its reminder settings change; SENT/FAILED/SKIPPED rows are history and never rewritten.
model ReminderEvent {
  id            String              @id @default(uuid(7)) @db.Uuid
  /// The customer account this row belongs to. Filled in by the database from the request's
  /// account (see src/server/db.ts); row-level security keeps accounts apart.
  accountId     String              @default(dbgenerated("current_account_id()")) @db.Uuid
  account       Account             @relation(fields: [accountId], references: [id])
  leaseId       String              @db.Uuid
  lease         Lease               @relation(fields: [leaseId], references: [id])
  scheduledDate DateTime            @db.Date
  kind          ReminderKind
  /// Days before the lease end (negative after it).
  daysBefore    Int
  status        ReminderEventStatus @default(PENDING)
  digestId      String?             @db.Uuid
  digest        ReminderDigest?     @relation(fields: [digestId], references: [id])
  sentAt        DateTime?           @db.Timestamptz(3)
  skippedReason String?
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([leaseId, scheduledDate])
  @@index([accountId, status, scheduledDate])
}

enum DigestStatus {
  SENDING
  SENT
  FAILED
  /// Nothing needed attention that day; no email was sent.
  EMPTY
}

/// The one reminder email per day. Makes the daily job idempotent and records failures.
model ReminderDigest {
  id           String          @id @default(uuid(7)) @db.Uuid
  /// The customer account this row belongs to. Filled in by the database from the request's
  /// account (see src/server/db.ts); row-level security keeps accounts apart.
  accountId    String          @default(dbgenerated("current_account_id()")) @db.Uuid
  account      Account         @relation(fields: [accountId], references: [id])
  digestDate   DateTime        @db.Date
  status       DigestStatus
  /// Active Admin and Leasing Staff user ids the email went to.
  recipientIds String[]        @db.Uuid
  leaseCount   Int             @default(0)
  attempts     Int             @default(0)
  lastError    String?
  sentAt       DateTime?       @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  events       ReminderEvent[]

  @@unique([accountId, digestDate])
}

// ─── Money ─────────────────────────────────────────────────────────────────────
// Posted money records are never edited or deleted: they are voided (or cancelled) with a reason.

enum ChargeType {
  RENT
  DEPOSIT
  ADVANCE
  OTHER
}

enum ChargeStatus {
  ACTIVE
  /// Removed automatically (terms changed, lease ended early) before anything was paid.
  CANCELLED
  /// Removed by a person, with a reason.
  VOID
}

model Charge {
  id           String       @id @default(uuid(7)) @db.Uuid
  /// The customer account this row belongs to. Filled in by the database from the request's
  /// account (see src/server/db.ts); row-level security keeps accounts apart.
  accountId    String       @default(dbgenerated("current_account_id()")) @db.Uuid
  account      Account      @relation(fields: [accountId], references: [id])
  leaseId      String       @db.Uuid
  lease        Lease        @relation(fields: [leaseId], references: [id])
  type         ChargeType
  /// Rent: billing period start (YYYY-MM-DD); deposit/advance: the type name; other: null.
  key          String?
  periodStart  DateTime?    @db.Date
  periodEnd    DateTime?    @db.Date
  dueDate      DateTime     @db.Date
  amount       Decimal      @db.Decimal(14, 2)
  description  String
  status       ChargeStatus @default(ACTIVE)
  statusReason String?
  statusAt     DateTime?    @db.Timestamptz(3)
  statusById   String?      @db.Uuid

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid

  allocations PaymentAllocation[]

  @@index([leaseId, status])
  @@index([accountId, dueDate])
}

enum PaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
  ONLINE
}

enum PaymentStatus {
  POSTED
  VOID
}

model Payment {
  id           String        @id @default(uuid(7)) @db.Uuid
  /// The customer account this row belongs to. Filled in by the database from the request's
  /// account (see src/server/db.ts); row-level security keeps accounts apart.
  accountId    String        @default(dbgenerated("current_account_id()")) @db.Uuid
  account      Account       @relation(fields: [accountId], references: [id])
  /// e.g. PAY-2026-0001 (shown on the acknowledgement; not an official receipt number)
  paymentNo    String
  leaseId      String        @db.Uuid
  lease        Lease         @relation(fields: [leaseId], references: [id])
  receivedDate DateTime      @db.Date
  amount       Decimal       @db.Decimal(14, 2)
  method       PaymentMethod
  /// OR no., cheque no., bank reference…
  reference    String?
  notes        String?
  status       PaymentStatus @default(POSTED)
  voidReason   String?
  voidedAt     DateTime?     @db.Timestamptz(3)
  voidedById   String?       @db.Uuid

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid

  allocations PaymentAllocation[]

  @@unique([accountId, paymentNo])
  @@index([leaseId, status])
  @@index([accountId, receivedDate])
}

/// How much of a payment went to which charge. Replaced (not edited) when re-allocated.
model PaymentAllocation {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// The customer account this row belongs to. Filled in by the database from the request's
  /// account (see src/server/db.ts); row-level security keeps accounts apart.
  accountId String   @default(dbgenerated("current_account_id()")) @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id])
  paymentId String   @db.Uuid
  payment   Payment  @relation(fields: [paymentId], references: [id])
  chargeId  String   @db.Uuid
  charge    Charge   @relation(fields: [chargeId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([chargeId])
  @@index([paymentId])
}

model PaymentCounter {
  accountId String  @default(dbgenerated("current_account_id()")) @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])
  year      Int
  lastSeq   Int

  @@id([accountId, year])
}

// ─── Documents ─────────────────────────────────────────────────────────────────

enum DocumentCategory {
  SIGNED_CONTRACT
  AMENDMENT
  ID
  OTHER
}

/// A file attached to a lease (and its tenant) or to a tenant only. The file itself lives in
/// private storage (local disk or S3) under `storageKey`; it is never served directly.
model Document {
  id            String           @id @default(uuid(7)) @db.Uuid
  /// The customer account this row belongs to. Filled in by the database from the request's
  /// account (see src/server/db.ts); row-level security keeps accounts apart.
  accountId     String           @default(dbgenerated("current_account_id()")) @db.Uuid
  account       Account          @relation(fields: [accountId], references: [id])
  tenantId      String           @db.Uuid
  leaseId       String?          @db.Uuid
  category      DocumentCategory
  /// Original file name, cleaned of path parts and control characters.
  fileName      String
  contentType   String
  sizeBytes     Int
  sha256        String
  storageKey    String           @unique
  uploadedById  String?          @db.Uuid
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  archivedAt    DateTime?        @db.Timestamptz(3)
  archivedById  String?          @db.Uuid
  archiveReason String?

  @@index([accountId])
  @@index([tenantId])
  @@index([leaseId])
}

// ─── UAT feedback ──────────────────────────────────────────────────────────────

enum FeedbackStatus {
  NEW
  DONE
}

/// Notes from testers ("Send feedback"). The page path is stored without its query string.
model Feedback {
  id        String         @id @default(uuid(7)) @db.Uuid
  /// The customer account this row belongs to. Filled in by the database from the request's
  /// account (see src/server/db.ts); row-level security keeps accounts apart.
  accountId String         @default(dbgenerated("current_account_id()")) @db.Uuid
  account   Account        @relation(fields: [accountId], references: [id])
  userId    String?        @db.Uuid
  userName  String
  role      Role
  pagePath  String
  message   String
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  doneAt    DateTime?      @db.Timestamptz(3)
  doneById  String?        @db.Uuid

  @@index([accountId, status, createdAt])
}

// ─── Rate limits ───────────────────────────────────────────────────────────────

/// Fixed-window counters for sign-in, codes and password resets (by IP address and by email).
/// The key is a SHA-256 hash, so no address or email is stored.
model RateLimit {
  key         String   @id
  windowStart DateTime @db.Timestamptz(3)
  count       Int

  @@index([windowStart])
}
