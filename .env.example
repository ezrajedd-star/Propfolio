# ─── Propfolio environment ─────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit real secrets.

# PostgreSQL connection string. In production use a managed Postgres with
# encryption at rest and TLS (append `?sslmode=require`).
DATABASE_URL="postgresql://propfolio:propfolio@localhost:5432/propfolio"

# Public base URL of the app, used in email links. Must be https:// in production —
# this also turns on Secure / __Host- session cookies.
APP_URL="http://localhost:3000"

# Email. MAIL_TRANSPORT=smtp sends through the SMTP server below.
# MAIL_TRANSPORT=log sends nothing (development/tests only).
MAIL_TRANSPORT="smtp"
MAIL_FROM="Propfolio <no-reply@example.com>"
# Local development: Mailpit from docker compose (web UI on http://localhost:8025).
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# Optional: one known password for all seed users (development only).
# Leave empty to generate random passwords, printed when you run `pnpm db:seed`.
SEED_PASSWORD=""

# ─── Docker Compose only ───────────────────────────────────────────────────────
POSTGRES_PASSWORD="change-me-local-only"

# Signs 5-minute document download links. Required in production: openssl rand -hex 32
APP_SECRET=""

# Uploaded documents. local = a private folder (STORAGE_DIR); s3 = a private S3-compatible bucket.
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
# S3_BUCKET=""
# S3_REGION="ap-southeast-1"
# S3_ENDPOINT=""            # only for non-AWS services, e.g. https://sgp1.digitaloceanspaces.com
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Test (UAT) version: "Test version" banner and "Send feedback" button.
UAT_MODE="false"
# Don't email demo addresses (@propfolio.test …). Set to true on hosted servers.
MAIL_SKIP_TEST_DOMAINS="false"
