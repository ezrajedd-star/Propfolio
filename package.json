{
  "name": "propfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Propfolio — lease ledger for rental property companies",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx --tsconfig tsconfig.worker.json worker/index.ts",
    "worker:dev": "tsx watch --tsconfig tsconfig.worker.json worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --tsconfig tsconfig.worker.json prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "qa": "playwright test --config qa/playwright.config.ts",
    "platform:admin": "tsx --tsconfig tsconfig.worker.json scripts/platform-admin.ts"
  },
  "prisma": {
    "seed": "tsx --tsconfig tsconfig.worker.json prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@date-fns/tz": "1.5.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/list": "6.1.22",
    "@fullcalendar/react": "6.1.22",
    "@hookform/resolvers": "5.9.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.2.0",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "lucide-react": "0.577.0",
    "next": "16.4.4",
    "nodemailer": "10.3.1",
    "pg-boss": "12.38.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "next>postcss": "8.5.32",
      "@prisma/config>deepmerge-ts": "8.0.2",
      "exceljs>uuid": "11.1.1"
    }
  }
}
