{
  "name": "propfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Propfolio — lease ledger for rental property companies",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx --tsconfig tsconfig.worker.json worker/index.ts",
    "worker:dev": "tsx watch --tsconfig tsconfig.worker.json worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --tsconfig tsconfig.worker.json prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "tsx --tsconfig tsconfig.worker.json prisma/seed.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "decimal.js": "10.6.0",
    "lucide-react": "0.577.0",
    "next": "15.5.28",
    "nodemailer": "7.0.13",
    "pg-boss": "10.4.2",
    "radix-ui": "1.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-hook-form": "7.69.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.19.1",
    "@types/nodemailer": "7.0.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver"
    ]
  }
}
